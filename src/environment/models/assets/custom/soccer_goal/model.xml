<mujoco model="soccer_goal">
  <compiler angle="radian" autolimits="true" meshdir="."/>

  <asset>
    <!-- The source OBJ is Y-up.  Each visual geom is rotated into MuJoCo Z-up. -->
    <mesh name="soccer_goal_frame_mesh" file="goal_frame.obj"/>
    <mesh name="soccer_goal_net_mesh" file="goal_net.obj"/>
    <mesh name="soccer_goal_support_mesh" file="goal_supports.obj"/>
    <material name="soccer_goal_white" rgba="0.94 0.95 0.96 1" specular="0.28" shininess="0.18"/>
    <material name="soccer_goal_net" rgba="0.72 0.74 0.77 0.72" specular="0.08" shininess="0.05"/>
    <material name="soccer_goal_dark" rgba="0.055 0.060 0.070 1" specular="0.18" shininess="0.12"/>
  </asset>

  <worldbody>
    <body name="soccer_goal">
      <geom name="goal_frame_visual" type="mesh" mesh="soccer_goal_frame_mesh"
            material="soccer_goal_white" euler="1.57079632679 0 0"
            contype="0" conaffinity="0" density="0" group="0"/>
      <geom name="goal_net_visual" type="mesh" mesh="soccer_goal_net_mesh"
            material="soccer_goal_net" euler="1.57079632679 0 0"
            contype="0" conaffinity="0" density="0" group="0"/>
      <geom name="goal_support_visual" type="mesh" mesh="soccer_goal_support_mesh"
            material="soccer_goal_dark" euler="1.57079632679 0 0"
            contype="0" conaffinity="0" density="0" group="0"/>

      <!-- Stable primitive collisions: front uprights/crossbar and ground braces. -->
      <geom name="goal_left_post_collision" type="capsule"
            fromto="-2.49 -0.73 0.06  -2.49 -0.73 1.99" size="0.06"
            rgba="0 0 0 0" group="3" density="90" friction="0.9 0.1 0.01"/>
      <geom name="goal_right_post_collision" type="capsule"
            fromto="2.49 -0.73 0.06  2.49 -0.73 1.99" size="0.06"
            rgba="0 0 0 0" group="3" density="90" friction="0.9 0.1 0.01"/>
      <geom name="goal_crossbar_collision" type="capsule"
            fromto="-2.49 -0.73 1.99  2.49 -0.73 1.99" size="0.06"
            rgba="0 0 0 0" group="3" density="90" friction="0.9 0.1 0.01"/>
      <geom name="goal_left_brace_collision" type="capsule"
            fromto="-2.49 -0.73 0.06  -2.49 1.78 0.06" size="0.045"
            rgba="0 0 0 0" group="3" density="90" friction="0.9 0.1 0.01"/>
      <geom name="goal_right_brace_collision" type="capsule"
            fromto="2.49 -0.73 0.06  2.49 1.78 0.06" size="0.045"
            rgba="0 0 0 0" group="3" density="90" friction="0.9 0.1 0.01"/>
      <!-- The net, as thin boxes where the net mesh hangs: the goal line is the posts
           (y -0.73), the back of the net the frame's back (y 0.76).  A ball that
           crosses the line stays in the goal; the rear supports behind are not part
           of it.  The referee reads *_back_net_collision for the goal's depth. -->
      <geom name="goal_back_net_collision" type="box" pos="0 0.76 1.0" size="2.49 0.02 1.0"
            rgba="0 0 0 0" group="3" density="10" friction="0.9 0.1 0.01"/>
      <geom name="goal_left_net_collision" type="box" pos="-2.49 0.015 1.0" size="0.02 0.745 1.0"
            rgba="0 0 0 0" group="3" density="10" friction="0.9 0.1 0.01"/>
      <geom name="goal_right_net_collision" type="box" pos="2.49 0.015 1.0" size="0.02 0.745 1.0"
            rgba="0 0 0 0" group="3" density="10" friction="0.9 0.1 0.01"/>
      <geom name="goal_top_net_collision" type="box" pos="0 0.015 2.0" size="2.49 0.745 0.02"
            rgba="0 0 0 0" group="3" density="10" friction="0.9 0.1 0.01"/>
    </body>
  </worldbody>
</mujoco>
