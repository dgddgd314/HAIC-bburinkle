<mujoco model="soccer_pitch_markings_model">
  <compiler angle="radian" boundmass="0.001"/>
  <default>
    <geom group="0" contype="0" conaffinity="0" rgba="0.96 0.96 0.92 1"/>
  </default>
  <asset>
    <mesh name="center_circle_ring_mesh" file="center_circle_ring.obj"/>
    <mesh name="ball_position_ring_mesh" file="ball_position_ring.obj"/>
  </asset>
  <worldbody>
    <body name="soccer_pitch_markings">
      <!-- 6.80 x 9.80 m playable rectangle in the widened 7.5 m room. -->
      <geom name="touchline_w" type="box" pos="-3.40 0 0.00015" size="0.025 4.90 0.00010"/>
      <geom name="touchline_e" type="box" pos="3.40 0 0.00015" size="0.025 4.90 0.00010"/>
      <geom name="goal_line_s" type="box" pos="0 -4.90 0.00015" size="3.40 0.025 0.00010"/>
      <geom name="goal_line_n" type="box" pos="0 4.90 0.00015" size="3.40 0.025 0.00010"/>
      <geom name="halfway_line" type="box" pos="0 0 0.00015" size="3.40 0.025 0.00010"/>

      <!-- Goal-side penalty area only; the opposite rectangle was removed. -->
      <geom name="penalty_s_top" type="box" pos="0 -3.30 0.00015" size="1.70 0.025 0.00010"/>
      <geom name="penalty_s_left" type="box" pos="-1.70 -4.10 0.00015" size="0.025 0.80 0.00010"/>
      <geom name="penalty_s_right" type="box" pos="1.70 -4.10 0.00015" size="0.025 0.80 0.00010"/>

      <!-- Smooth 128-segment annulus instead of a visible 16-gon. -->
      <geom name="center_circle_ring" type="mesh" mesh="center_circle_ring_mesh" pos="0 0 0.00015"/>
      <!-- Hollow, smooth ball-position ring on the goal's centre axis.
           There is deliberately no filled disk or rectangular plate beneath it. -->
      <geom name="ball_position_ring" type="mesh" mesh="ball_position_ring_mesh" pos="0 2.90 0.00015"/>
    </body>
  </worldbody>
</mujoco>
