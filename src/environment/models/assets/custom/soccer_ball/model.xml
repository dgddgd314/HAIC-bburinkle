  <worldbody>
    <body name="soccer_ball">
      <geom name="soccer_ball_white_visual" type="mesh" mesh="soccer_ball_white_mesh"
            material="soccer_ball_white" contype="0" conaffinity="0"
            density="0" group="0"/>
      <geom name="soccer_ball_black_visual" type="mesh" mesh="soccer_ball_black_mesh"
            material="soccer_ball_black" contype="0" conaffinity="0"
            density="0" group="0"/>
      <geom name="soccer_ball_collision" type="sphere" size="0.11"
            rgba="0 0 0 0" group="3" mass="0.43"
            friction="0.72 0.02 0.002" solref="0.008 1"/>
    </body>
  </worldbody>
</mujoco>
