    <mesh name="soccer_ball_black_mesh" file="ball_black.obj" scale="0.1045 0.1045 0.1045"/>
    <material name="soccer_ball_white" rgba="0.91 0.91 0.88 1" specular="0.20" shininess="0.08"/>
    <material name="soccer_ball_black" rgba="0.018 0.020 0.023 1" specular="0.18" shininess="0.08"/>
