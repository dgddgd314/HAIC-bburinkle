<mujoco model="downloaded_textured_pencil">
  <compiler angle="degree" autolimits="true" meshdir="." texturedir="."/>

  <asset>
    <!-- Original OBJ long axis is +Y. Scale it to about 28.9 cm and make
         the cross-section about 8% thicker for a more reliable Panda grasp. -->
    <mesh name="downloaded_pencil_mesh" file="pencil.obj"
          scale="0.025569678 0.014763743 0.025569678"/>
    <texture name="downloaded_pencil_texture" type="2d"
             file="pencil_baseColor.png"/>
    <material name="downloaded_pencil_material"
              texture="downloaded_pencil_texture"
              rgba="1 1 1 1" roughness="0.72"/>
  </asset>

  <worldbody>
    <body name="wooden_pencil">
      <!-- Rotate OBJ Y onto local X and recenter its source-space origin. The
           14.5 mm collision radius is paired with a 15.1 mm task spawn height,
           so the pencil settles horizontally without desk interpenetration. -->
      <geom name="downloaded_pencil_visual" type="mesh"
            mesh="downloaded_pencil_mesh"
            material="downloaded_pencil_material"
            pos="-0.18861178 0.02203031 -0.03455045" euler="0 0 -90"
            contype="0" conaffinity="0" density="0" group="0"/>

      <!-- Stable grasp proxy. The editor adds a free joint because this asset
           and the randomized task instance are both marked dynamic. -->
      <geom name="pencil_collision" type="capsule"
            fromto="-0.130 0 0 0.130 0 0" size="0.0145"
            rgba="0 0 0 0" group="3" density="430"
            contype="1" conaffinity="1" friction="0.78 0.012 0.001"
            solref="0.006 1" solimp="0.92 0.99 0.002"/>
    </body>
  </worldbody>
</mujoco>
